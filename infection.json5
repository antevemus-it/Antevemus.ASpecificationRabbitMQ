// Mutation testing of antevemus/aspecification-rabbitmq (1.0.0): the whole src/. Runs in the scheduled workflow
// (.github/workflows/quality.yml) with a coverage driver (pcov) and a RabbitMQ 3.13 service (most of src/ is only
// exercised by the tests that talk to the broker); locally, with a broker reachable (see phpunit.xml.dist):
//
//   RABBITMQ_PORT=15672 XDEBUG_MODE=off vendor/bin/infection --threads=8 --only-covering-test-cases \
//       --initial-tests-php-options="-d pcov.enabled=1 -d pcov.directory=$PWD/src"
//
// Measured on 2026-11-15 (1.0.0 against ASpecification 2.14.0 and RabbitMQ 3.13, Infection 0.35.11, PHP 8.4.27
// with pcov): 274 mutants, 269 killed, 1 time-out (the deadline of the wait moved to the future: an endless poll),
// 0 errors, 4 escaped, all equivalent, all in the wait of RabbitMqSource::receive(). They come from a pool of seven
// equivalents of the clock of the wait, of which the timing tests kill some in one run and others in the next
// (two runs of the same code: the same 4 escaped, not the same 4 mutants):
// - IncrementInteger/DecrementInteger of `$waitMs * 1_000_000` (999 999 or 1 000 001 nanoseconds per millisecond:
//   the wait off by one part in a million, below what the clock of a test can tell);
// - IncrementInteger/DecrementInteger of `$this->pollIntervalMs * 1000` and of `intdiv($remaining, 1000)` (a pause
//   off by one part in a thousand; the deadline is checked again after every pause);
// - LessThanOrEqualTo of `$remaining <= 0` (`< 0`: differs only when the remaining time is exactly zero
//   nanoseconds, and then the next turn pulls once more and returns).
// MSI 98.54%, covered-code MSI 98.54%, mutation code coverage 100%. The minimum scores are one integer point
// below.
{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 60,
    "logs": {
        "text": "coverage/infection/infection.log",
        "summary": "coverage/infection/summary.log",
        "json": "coverage/infection/infection.json",
        "perMutator": "coverage/infection/per-mutator.md"
    },
    "tmpDir": "coverage/infection/tmp",
    "phpUnit": {
        "configDir": "."
    },
    "minMsi": 97,
    "minCoveredMsi": 97,
    "mutators": {
        "@default": true
    }
}
